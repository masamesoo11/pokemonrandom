# ====================================
# Pokemon Random - Environment Variables
# ====================================
# Copy this file to .env.local (for local dev) OR set these in your hosting
# provider's dashboard (Vercel: Project Settings → Environment Variables).
# All NEXT_PUBLIC_* variables are exposed to the browser, so do NOT put
# secrets in them.

# ---- Site URL (your final domain) ----
NEXT_PUBLIC_SITE_URL=https://pokemonrandom.com

# ---- Admin Panel Password ----
# Change this immediately! Used to access /admin dashboard.
ADMIN_PASSWORD=change-this-to-a-strong-password-2024

# ---- Google Analytics 4 (optional, recommended) ----
# Get it from: https://analytics.google.com → Admin → Create Property
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ---- Google AdSense (optional, after AdSense approval) ----
# Get it from: https://adsense.google.com → Ads → By ad unit → Create
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=

# Ad Slot IDs - create 5 separate ad units in AdSense:
# Get them from: adsense.google.com → Ads → By ad unit → (each unit's data-ad-slot)
NEXT_PUBLIC_AD_SLOT_HEADER=
NEXT_PUBLIC_AD_SLOT_INCONTENT=
NEXT_PUBLIC_AD_SLOT_SIDEBAR=
NEXT_PUBLIC_AD_SLOT_FOOTER=
NEXT_PUBLIC_AD_SLOT_MOBILE=

# ---- Google Search Console verification (optional, recommended) ----
# Get it from: https://search.google.com/search-console → Add Property → URL prefix
# → Verify with HTML tag (the value is the "content" attribute of the meta tag)
NEXT_PUBLIC_SEARCH_CONSOLE=

# ---- Database (for Prisma - already configured, don't change) ----
DATABASE_URL=file:/home/z/my-project/db/custom.db
